# Copy to .env and fill in. Never commit .env.

# From @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=123456789:AAaBbCcDdEeFfGgHhIiJjKkLlMmNnOoPpQq

# Numeric chat id. For a channel the bot must be an admin; the id looks
# like -1001234567890. Easiest way to find it:
#   1. send any message in the target chat / post in the channel
#   2. curl "https://api.telegram.org/bot<TOKEN>/getUpdates"
#   3. read result[].message.chat.id (or channel_post.chat.id)
TELEGRAM_CHAT_ID=-1001234567890

# Advertised in the User-Agent so the site owner can reach you.
CONTACT_EMAIL=you@example.com

# Optional overrides for config.yaml defaults
# DB_PATH=data/sentinel.db
# LOG_DIR=logs
# LOG_LEVEL=INFO
# BOOTSTRAP=seed
